# Copy to `.env.local` — never commit real secrets.

# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: create viewer accounts from Admin → Access (Supabase Dashboard → Settings → API → service_role).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional but recommended on Vercel — canonical site URL for metadata & OAuth redirects.
# Locally defaults to http://localhost:3000 via app/layout.tsx when unset.
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
